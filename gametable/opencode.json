{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "navigation_v1": {
      "type": "local",
      "command": [
        "./organism/op/organism.sh",
        "serve",
        "navigation"
      ],
      "cwd": "..",
      "enabled": true,
      "timeout": 300000
    },
    "learning_v1": {
      "type": "local",
      "command": [
        "./organism/op/organism.sh",
        "serve",
        "learning"
      ],
      "cwd": "..",
      "enabled": true,
      "timeout": 300000
    }
  },
  "default_agent": "yuki",
  "model": "openai/gpt-5.6-luna"
}
