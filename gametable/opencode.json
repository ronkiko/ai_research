{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "game_v1": {
      "type": "local",
      "command": [
        "./gameclient/v1/op/mcp.sh"
      ],
      "cwd": "..",
      "enabled": true,
      "timeout": 60000
    },
    "gamelab_v1": {
      "type": "local",
      "command": [
        "./gamelab/op/gamelab.sh",
        "serve"
      ],
      "cwd": "..",
      "enabled": true,
      "timeout": 300000
    }
  },
  "default_agent": "yuki",
  "model": "openai/gpt-5.6-luna"
}
